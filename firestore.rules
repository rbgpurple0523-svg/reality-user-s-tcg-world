rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /rooms/{roomId} {

      function isStageStale() {
        let now = request.time.toMillis();

        let hostLastSeen =
          exists(
            /databases/$(database)/documents/rooms/$(roomId)/presence/host
          )
            ? get(
                /databases/$(database)/documents/rooms/$(roomId)/presence/host
              ).data.lastSeenAt
            : 0;

        let guestLastSeen =
          exists(
            /databases/$(database)/documents/rooms/$(roomId)/presence/guest
          )
            ? get(
                /databases/$(database)/documents/rooms/$(roomId)/presence/guest
              ).data.lastSeenAt
            : 0;

        return
          (hostLastSeen == 0 || now - hostLastSeen > 60000)
          &&
          (guestLastSeen == 0 || now - guestLastSeen > 60000);
      }

      function isStaleClosedRoomCleanup() {
        return
          request.auth != null
          &&
          get(
            /databases/$(database)/documents/rooms/$(roomId)
          ).data.roomClosed == true
          &&
          get(
            /databases/$(database)/documents/rooms/$(roomId)
          ).data.exitHost == false
          &&
          get(
            /databases/$(database)/documents/rooms/$(roomId)
          ).data.exitGuest == false;
      }

      function isStaleStageClosure() {
        return
          request.auth != null
          &&
          resource.data.roomClosed != true
          &&
          resource.data.exitHost == false
          &&
          resource.data.exitGuest == false
          &&
          isStageStale()
          &&
          request.resource.data.roomClosed == true
          &&
          request.resource.data.exitHost == false
          &&
          request.resource.data.exitGuest == false
          &&
          request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'roomClosed'
            ]);
      }

      function isExplicitExit() {
        let changed =
          request.resource.data
            .diff(resource.data)
            .affectedKeys();

        return
          request.auth != null
          &&
          resource.data.roomClosed != true
          &&
          (
            (
              resource.data.hostUid
                == request.auth.uid
              &&
              changed.hasOnly([
                'exitHost',
                'roomClosed'
              ])
              &&
              request.resource.data.exitHost
                == true
              &&
              request.resource.data.roomClosed
                == true
            )
            ||
            (
              resource.data.guestUid
                == request.auth.uid
              &&
              changed.hasOnly([
                'exitGuest',
                'roomClosed'
              ])
              &&
              request.resource.data.exitGuest
                == true
              &&
              request.resource.data.roomClosed
                == true
            )
          );
      }

      function isValidBattleStateTransition() {
        return

          (
            !request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasAny([
                'currentYear',
                'turnIndex',
                'battlePhase',
                'firstPlayer',
                'startSeasonIdx'
              ])
          )

          ||

          (
            !resource.data.keys().hasAny([
              'currentYear',
              'turnIndex',
              'battlePhase',
              'firstPlayer',
              'startSeasonIdx'
            ])

            &&
            request.resource.data.currentYear
              == resource.data.currentYear
            &&
            request.resource.data.turnIndex == 0
            &&
            request.resource.data.battlePhase == 'setup'
            &&
            request.resource.data.firstPlayer == null
            &&
            request.resource.data.startSeasonIdx == null
          )

          ||

          (
            resource.data.battlePhase == 'battle'
            &&
            resource.data.turnIndex >= 0
            &&
            resource.data.turnIndex < 7

            &&
            request.resource.data.currentYear
              == resource.data.currentYear

            &&
            request.resource.data.turnIndex
              == resource.data.turnIndex + 1

            &&
            request.resource.data.battlePhase
              == 'battle'

            &&
            request.resource.data.firstPlayer
              == resource.data.firstPlayer

            &&
            request.resource.data.startSeasonIdx
              == resource.data.startSeasonIdx
          )

          ||

          (
            resource.data.battlePhase == 'battle'
            &&
            resource.data.turnIndex == 7
            &&
            resource.data.currentYear < 3

            &&
            request.resource.data.currentYear
              == resource.data.currentYear + 1

            &&
            request.resource.data.turnIndex == 0
            &&
            request.resource.data.battlePhase == 'setup'
            &&
            request.resource.data.firstPlayer == null
            &&
            request.resource.data.startSeasonIdx == null
          )

          ||

          (
            resource.data.battlePhase == 'battle'
            &&
            resource.data.currentYear == 3
            &&
            resource.data.turnIndex == 7

            &&
            request.resource.data.currentYear == 3
            &&
            request.resource.data.turnIndex == 7
            &&
            request.resource.data.battlePhase == 'finished'

            &&
            request.resource.data.firstPlayer
              == resource.data.firstPlayer

            &&
            request.resource.data.startSeasonIdx
              == resource.data.startSeasonIdx
          )

          ||

          (
            resource.data.battlePhase == 'setup'
            &&
            request.resource.data.battlePhase == 'battle'

            &&
            request.resource.data.currentYear
              == resource.data.currentYear

            &&
            request.resource.data.turnIndex == 0

            &&
            (
              request.resource.data.firstPlayer == 'host'
              ||
              request.resource.data.firstPlayer == 'guest'
            )

            &&
            request.resource.data.startSeasonIdx == 0
          )

          ||

          (
            resource.data.battlePhase == 'setup'
            &&
            request.resource.data.battlePhase == 'setup'

            &&
            request.resource.data.currentYear
              == resource.data.currentYear

            &&
            request.resource.data.turnIndex == 0

            &&
            request.resource.data.firstPlayer == null

            &&
            request.resource.data.startSeasonIdx == null
          );
      }

      function isValidBattleDeckSnapshotShape(snapshot) {
        return
          snapshot is map
          &&
          snapshot.version == 1
          &&
          snapshot.deckName is string
          &&
          snapshot.deckName.size() > 0
          &&
          snapshot.characters is list
          &&
          snapshot.characters.size() == 3
          &&
          snapshot.characters[0] is map
          &&
          snapshot.characters[0].role == 'vanguard'
          &&
          snapshot.characters[0].cardId is string
          &&
          snapshot.characters[0].cardId != ''
          &&
          snapshot.characters[1] is map
          &&
          snapshot.characters[1].role == 'center'
          &&
          snapshot.characters[1].cardId is string
          &&
          snapshot.characters[1].cardId != ''
          &&
          snapshot.characters[2] is map
          &&
          snapshot.characters[2].role == 'general'
          &&
          snapshot.characters[2].cardId is string
          &&
          snapshot.characters[2].cardId != ''
          &&
          snapshot.supportCards is list
          &&
          snapshot.supportCards.size() == 18;
      }

      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.roomClosed == false
        && request.resource.data.exitHost == false
        && request.resource.data.exitGuest == false
        && request.resource.data.battlePhase == 'setup'
        && request.resource.data.turnIndex == 0
        && request.resource.data.firstPlayer == null
        && request.resource.data.startSeasonIdx == null
        && request.resource.data.hostTotalScore == 0
        && request.resource.data.guestTotalScore == 0
        && request.resource.data.hostClassScores == [0, 0, 0]
        && request.resource.data.guestClassScores == [0, 0, 0];

      allow update: if request.auth != null
        && (

          isStaleStageClosure()

          ||

          isExplicitExit()

          ||

          (
            resource.data.hostUid == request.auth.uid
            && resource.data.roomClosed != true
            && request.resource.data.hostUid == resource.data.hostUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'hostDeckId',
              'readyHost',
              'classReadyYearHost',
              'rematchHost',
              'rematchPlayerResetHost',
              'exitHost',
              'hostJoined',
              'hostRejoinedAt',
              'hostLastSeenAt'
            ])

            && isValidBattleStateTransition()

            && !request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasAny([
                'hostClassScores',
                'guestClassScores',
                'hostTotalScore',
                'guestTotalScore'
              ])

            && (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                'currentYear',
                'turnIndex',
                'battlePhase',
                'firstPlayer',
                'startSeasonIdx',
                'hostClassScores',
                'guestClassScores',
                'hostTotalScore',
                'guestTotalScore'
              ])

              ||

              (
                (
                  !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                    'currentYear'
                  ])
                  ||
                  (
                    request.resource.data.currentYear is int
                    && request.resource.data.currentYear >= 1
                    && request.resource.data.currentYear <= 3
                  )
                )

                &&

                (
                  !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                    'turnIndex'
                  ])
                  ||
                  (
                    request.resource.data.turnIndex is int
                    && request.resource.data.turnIndex >= 0
                    && request.resource.data.turnIndex <= 7
                  )
                )

                &&

                (
                  !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                    'battlePhase'
                  ])
                  ||
                  (
                    request.resource.data.battlePhase == 'setup'
                    || request.resource.data.battlePhase == 'battle'
                    || request.resource.data.battlePhase == 'finished'
                  )
                )

                &&

                (
                  !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                    'firstPlayer'
                  ])
                  ||
                  (
                    request.resource.data.firstPlayer == null
                    || request.resource.data.firstPlayer == 'host'
                    || request.resource.data.firstPlayer == 'guest'
                  )
                )

                &&

                (
                  !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                    'startSeasonIdx'
                  ])
                  ||
                  (
                    request.resource.data.startSeasonIdx == null
                    ||
                    (
                      request.resource.data.startSeasonIdx is int
                      && request.resource.data.startSeasonIdx >= 0
                      && request.resource.data.startSeasonIdx <= 3
                    )
                  )
                )

                &&

                (
                  !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                    'hostClassScores'
                  ])
                  ||
                  (
                    request.resource.data.hostClassScores is list
                    && request.resource.data.hostClassScores.size() == 3
                    && request.resource.data.hostClassScores[0] is number
                    && request.resource.data.hostClassScores[0] >= 0
                    && request.resource.data.hostClassScores[1] is number
                    && request.resource.data.hostClassScores[1] >= 0
                    && request.resource.data.hostClassScores[2] is number
                    && request.resource.data.hostClassScores[2] >= 0
                  )
                )

                &&

                (
                  !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                    'guestClassScores'
                  ])
                  ||
                  (
                    request.resource.data.guestClassScores is list
                    && request.resource.data.guestClassScores.size() == 3
                    && request.resource.data.guestClassScores[0] is number
                    && request.resource.data.guestClassScores[0] >= 0
                    && request.resource.data.guestClassScores[1] is number
                    && request.resource.data.guestClassScores[1] >= 0
                    && request.resource.data.guestClassScores[2] is number
                    && request.resource.data.guestClassScores[2] >= 0
                  )
                )

                &&

                (
                  !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                    'hostTotalScore'
                  ])
                  ||
                  (
                    request.resource.data.hostTotalScore is number
                    && request.resource.data.hostTotalScore >= 0
                  )
                )

                &&

                (
                  !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                    'guestTotalScore'
                  ])
                  ||
                  (
                    request.resource.data.guestTotalScore is number
                    && request.resource.data.guestTotalScore >= 0
                  )
                )
              )
            )
          )

          ||

          (
            resource.data.guestUid == request.auth.uid
            && resource.data.roomClosed != true
            && request.resource.data.hostUid == resource.data.hostUid
            && request.resource.data.guestUid == resource.data.guestUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'guestDeckId',
              'readyGuest',
              'classReadyYearGuest',
              'rematchGuest',
              'rematchPlayerResetGuest',
              'exitGuest',
              'guestJoined',
              'guestLastSeenAt',
              'guestRejoinedAt'
            ])

            && isValidBattleStateTransition()

            && !request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasAny([
                'hostClassScores',
                'guestClassScores',
                'hostTotalScore',
                'guestTotalScore'
              ])

            && (
              !request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasAny([
                  'firstPlayer',
                  'startSeasonIdx'
                ])
              ||
              (
                request.resource.data.firstPlayer == null
                && request.resource.data.startSeasonIdx == null
              )
              ||
              (
                request.resource.data.firstPlayer
                  == resource.data.firstPlayer
                && request.resource.data.startSeasonIdx
                  == resource.data.startSeasonIdx
              )
            )

            && (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                'currentYear',
                'turnIndex',
                'battlePhase',
                'firstPlayer',
                'startSeasonIdx',
                'hostClassScores',
                'guestClassScores',
                'hostTotalScore',
                'guestTotalScore'
              ])

              ||

              (
                (
                  !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                    'currentYear'
                  ])
                  ||
                  (
                    request.resource.data.currentYear is int
                    && request.resource.data.currentYear >= 1
                    && request.resource.data.currentYear <= 3
                  )
                )

                &&

                (
                  !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                    'turnIndex'
                  ])
                  ||
                  (
                    request.resource.data.turnIndex is int
                    && request.resource.data.turnIndex >= 0
                    && request.resource.data.turnIndex <= 7
                  )
                )

                &&

                (
                  !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                    'battlePhase'
                  ])
                  ||
                  (
                    request.resource.data.battlePhase == 'setup'
                    || request.resource.data.battlePhase == 'battle'
                    || request.resource.data.battlePhase == 'finished'
                  )
                )

                &&

                (
                  !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                    'firstPlayer'
                  ])
                  ||
                  (
                    request.resource.data.firstPlayer == null
                    || request.resource.data.firstPlayer == 'host'
                    || request.resource.data.firstPlayer == 'guest'
                  )
                )

                &&

                (
                  !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                    'startSeasonIdx'
                  ])
                  ||
                  (
                    request.resource.data.startSeasonIdx == null
                    ||
                    (
                      request.resource.data.startSeasonIdx is int
                      && request.resource.data.startSeasonIdx >= 0
                      && request.resource.data.startSeasonIdx <= 3
                    )
                  )
                )

                &&

                (
                  !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                    'hostClassScores'
                  ])
                  ||
                  (
                    request.resource.data.hostClassScores is list
                    && request.resource.data.hostClassScores.size() == 3
                    && request.resource.data.hostClassScores[0] is number
                    && request.resource.data.hostClassScores[0] >= 0
                    && request.resource.data.hostClassScores[1] is number
                    && request.resource.data.hostClassScores[1] >= 0
                    && request.resource.data.hostClassScores[2] is number
                    && request.resource.data.hostClassScores[2] >= 0
                  )
                )

                &&

                (
                  !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                    'guestClassScores'
                  ])
                  ||
                  (
                    request.resource.data.guestClassScores is list
                    && request.resource.data.guestClassScores.size() == 3
                    && request.resource.data.guestClassScores[0] is number
                    && request.resource.data.guestClassScores[0] >= 0
                    && request.resource.data.guestClassScores[1] is number
                    && request.resource.data.guestClassScores[1] >= 0
                    && request.resource.data.guestClassScores[2] is number
                    && request.resource.data.guestClassScores[2] >= 0
                  )
                )

                &&

                (
                  !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                    'hostTotalScore'
                  ])
                  ||
                  (
                    request.resource.data.hostTotalScore is number
                    && request.resource.data.hostTotalScore >= 0
                  )
                )

                &&

                (
                  !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                    'guestTotalScore'
                  ])
                  ||
                  (
                    request.resource.data.guestTotalScore is number
                    && request.resource.data.guestTotalScore >= 0
                  )
                )
              )
            )
          )

          ||

          (
            resource.data.guestUid == null
            && request.resource.data.guestUid == request.auth.uid
            && request.resource.data.hostUid == resource.data.hostUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'guestUid',
              'guestJoined',
              'guestRejoinedAt',
              'guestLastSeenAt'
            ])
          )
        );

      allow delete: if
        request.auth != null
        &&
        (
          (
            resource.data.roomClosed == true
            &&
            (
              resource.data.hostUid == request.auth.uid
              ||
              resource.data.guestUid == request.auth.uid
            )
          )
          ||
          isStaleClosedRoomCleanup()
        );

      match /players/{playerRole} {
        allow read: if request.auth != null;

        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.role == playerRole
          && request.resource.data.avatars is list
          && request.resource.data.avatars.size() == 0
          && request.resource.data.handCount == 0
          && request.resource.data.deckCount == 0
          && request.resource.data.usedSkills is map
          && request.resource.data.usedSkills.keys().size() == 0
          && !request.resource.data.keys().hasAny(['hand', 'deck', 'pendingAction'])
          && (
            (
              playerRole == 'host'
              && get(
                /databases/$(database)/documents/rooms/$(roomId)
              ).data.hostUid == request.auth.uid
            )
            ||
            (
              playerRole == 'guest'
              && get(
                /databases/$(database)/documents/rooms/$(roomId)
              ).data.guestUid == request.auth.uid
            )
          );

        function isRematchPlayerReset() {
          let room =
            get(/databases/$(database)/documents/rooms/$(roomId)).data;

          return
            room.rematchHost == true
            && room.rematchGuest == true
            && request.resource.data.handCount == 4
            && request.resource.data.deckCount == 14
            && request.resource.data.usedSkills is map
            && request.resource.data.usedSkills.keys().size() == 0
            && request.resource.data.avatars is list
            && request.resource.data.avatars.size() == 3
            && request.resource.data.lastProcessedIncomingActionId == ''
            && !request.resource.data.keys().hasAny([
              'pendingAction',
              'lastSkillActionId',
              'lastSkillAction',
              'lastSupportActionId',
              'lastSupportCardId',
              'lastSupportCardCountBefore',
              'lastSupportCardCountAfter',
              'lastSupportActionAt'
            ])
            && !request.resource.data.keys().hasAny([
              'hand',
              'deck'
            ])
            && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasAny([
                'pendingAction',
                'lastSkillActionId',
                'lastSkillAction',
                'lastSupportActionId',
                'lastSupportCardId',
                'lastSupportCardCountBefore',
                'lastSupportCardCountAfter',
                'lastSupportActionAt'
              ]);
        }

        allow update: if request.auth != null
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.createdAt == resource.data.createdAt

          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'joined',
            'ready',
            'lastSeenAt',
            'avatars',
            'handCount',
            'deckCount',
            'usedSkills',
            'pendingAction',
            'lastProcessedIncomingActionId',
            'lastSkillActionId',
            'lastSkillAction',
            'lastSupportActionId',
            'lastSupportCardId',
            'lastSupportCardCountBefore',
            'lastSupportCardCountAfter',
            'lastSupportActionAt',
            'hand',
            'deck'
          ])

          && (
            !request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasAny(['lastSkillAction'])
            ||
            isRematchPlayerReset()
          )

          && !request.resource.data.keys().hasAny([
            'hand',
            'deck'
          ])

          && (
            !request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasAny(['avatars'])
            ||
            getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.battlePhase == 'setup'
            ||
            isRematchPlayerReset()
          )

          && (
            !request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasAny([
                'usedSkills',
                'pendingAction',
                'lastSkillActionId',
                'lastSkillAction',
                'lastSupportActionId',
                'lastSupportCardId',
                'lastSupportCardCountBefore',
                'lastSupportCardCountAfter',
                'lastSupportActionAt'
              ])
            ||
            isRematchPlayerReset()
          )

          && (
            isRematchPlayerReset()
            ||
            !request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasAny(['pendingAction'])
            ||
            (
              request.resource.data.pendingAction is map
              && request.resource.data.pendingAction.keys().hasAll([
                'actionId',
                'type',
                'playerRole',
                'uid',
                'year',
                'turnIndex',
                'avatarIndex',
                'submittedAt'
              ])
              && request.resource.data.pendingAction.keys().hasOnly([
                'actionId',
                'type',
                'playerRole',
                'uid',
                'year',
                'turnIndex',
                'avatarIndex',
                'skillId',
                'selectedBoostStat',
                'supportCardId',
                'submittedAt',
                'supportCardConsumed',
                'supportCardCountBefore',
                'supportCardCountAfter'
              ])
              && request.resource.data.pendingAction.actionId is string
              && request.resource.data.pendingAction.actionId != ''
              && (
                request.resource.data.pendingAction.type == 'USE_SKILL'
                ||
                request.resource.data.pendingAction.type == 'PLAY_SUPPORT'
              )
              && request.resource.data.pendingAction.playerRole == playerRole
              && request.resource.data.pendingAction.uid == request.auth.uid
              && request.resource.data.pendingAction.year
                == get(/databases/$(database)/documents/rooms/$(roomId)).data.currentYear
              && request.resource.data.pendingAction.turnIndex
                == get(/databases/$(database)/documents/rooms/$(roomId)).data.turnIndex
              && get(/databases/$(database)/documents/rooms/$(roomId)).data.battlePhase == 'battle'
              && request.resource.data.pendingAction.avatarIndex
                == (get(/databases/$(database)/documents/rooms/$(roomId)).data.currentYear - 1)
              && request.resource.data.pendingAction.avatarIndex >= 0
              && request.resource.data.pendingAction.avatarIndex <= 2
              && request.resource.data.pendingAction.playerRole
                == (
                  get(/databases/$(database)/documents/rooms/$(roomId)).data.turnIndex % 2 == 0
                  ?
                    get(/databases/$(database)/documents/rooms/$(roomId)).data.firstPlayer
                  :
                    (
                      get(/databases/$(database)/documents/rooms/$(roomId)).data.firstPlayer == 'host'
                      ? 'guest'
                      : 'host'
                    )
                )
              && (
                (
                  request.resource.data.pendingAction.type == 'USE_SKILL'
                  && request.resource.data.pendingAction.keys().hasAll(['skillId'])
                  && request.resource.data.pendingAction.skillId is string
                  && request.resource.data.pendingAction.skillId != ''
                  && !request.resource.data.pendingAction.keys().hasAny([
                    'supportCardId',
                    'supportCardConsumed',
                    'supportCardCountBefore',
                    'supportCardCountAfter'
                  ])
                  && (
                    !request.resource.data.pendingAction.keys().hasAny(['selectedBoostStat'])
                    ||
                    request.resource.data.pendingAction.selectedBoostStat == 'hp'
                    ||
                    request.resource.data.pendingAction.selectedBoostStat == 'intellect'
                    ||
                    request.resource.data.pendingAction.selectedBoostStat == 'dexterity'
                    ||
                    request.resource.data.pendingAction.selectedBoostStat == 'charm'
                  )
                )
                ||
                (
                  request.resource.data.pendingAction.type == 'PLAY_SUPPORT'
                  && request.resource.data.pendingAction.keys().hasAll([
                    'supportCardId',
                    'supportCardConsumed',
                    'supportCardCountBefore',
                    'supportCardCountAfter'
                  ])
                  && request.resource.data.pendingAction.supportCardId is string
                  && request.resource.data.pendingAction.supportCardId != ''
                  && request.resource.data.pendingAction.supportCardConsumed == true
                  && request.resource.data.pendingAction.supportCardCountBefore >= 1
                  && request.resource.data.pendingAction.supportCardCountAfter
                    == request.resource.data.pendingAction.supportCardCountBefore - 1
                  && !request.resource.data.pendingAction.keys().hasAny([
                    'skillId',
                    'selectedBoostStat'
                  ])
                )
              )
            )
          )

          && (
            isRematchPlayerReset()
            ||
            !request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasAny(['lastSkillActionId'])
            ||
            (
              request.resource.data.lastSkillActionId is string
              && request.resource.data.lastSkillActionId != ''
              && request.resource.data.pendingAction is map
              && request.resource.data.pendingAction.actionId
                == request.resource.data.lastSkillActionId
              && request.resource.data.pendingAction.type == 'USE_SKILL'
            )
          )

          && (
            isRematchPlayerReset()
            ||
            !request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasAny(['lastSupportActionId'])
            ||
            (
              request.resource.data.lastSupportActionId is string
              && request.resource.data.lastSupportActionId != ''
              && request.resource.data.pendingAction is map
              && request.resource.data.pendingAction.actionId
                == request.resource.data.lastSupportActionId
              && request.resource.data.pendingAction.type == 'PLAY_SUPPORT'
              && request.resource.data.pendingAction.supportCardConsumed == true
            )
          );

        allow delete: if
          request.auth != null
          &&
          (
            (
              get(
                /databases/$(database)/documents/rooms/$(roomId)
              ).data.roomClosed == true
              &&
              (
                get(
                  /databases/$(database)/documents/rooms/$(roomId)
                ).data.hostUid == request.auth.uid
                ||
                get(
                  /databases/$(database)/documents/rooms/$(roomId)
                ).data.guestUid == request.auth.uid
              )
            )
            ||
            isStaleClosedRoomCleanup()
          );
      }

      match /presence/{playerRole} {

        allow read: if request.auth != null;

        allow create: if
          request.auth != null
          && (playerRole == 'host' || playerRole == 'guest')
          && (
            (playerRole == 'host' &&
              getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.hostUid == request.auth.uid)
            ||
            (playerRole == 'guest' &&
              getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.guestUid == request.auth.uid)
          )
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.role == playerRole;

        allow update: if
          request.auth != null
          &&
          (
            (
              (playerRole == 'host' || playerRole == 'guest')
              && (
                (playerRole == 'host' &&
                  get(
                    /databases/$(database)/documents/rooms/$(roomId)
                  ).data.hostUid == request.auth.uid)
                ||
                (playerRole == 'guest' &&
                  get(
                    /databases/$(database)/documents/rooms/$(roomId)
                  ).data.guestUid == request.auth.uid)
              )
              && resource.data.uid == request.auth.uid
              && request.resource.data.uid == resource.data.uid
              && request.resource.data.role == resource.data.role
              && request.resource.data.role == playerRole
              && request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasOnly([
                  'lastSeenAt'
                ])
            )
          );

        allow delete: if
          request.auth != null
          &&
          (
            (
              get(
                /databases/$(database)/documents/rooms/$(roomId)
              ).data.roomClosed == true
              &&
              (
                get(
                  /databases/$(database)/documents/rooms/$(roomId)
                ).data.hostUid == request.auth.uid
                ||
                get(
                  /databases/$(database)/documents/rooms/$(roomId)
                ).data.guestUid == request.auth.uid
              )
            )
            ||
            isStaleClosedRoomCleanup()
          );
      }

      match /privatePlayers/{playerRole} {

        allow create: if request.auth != null
          && get(/databases/$(database)/documents/rooms/$(roomId)).data.battlePhase == 'setup'
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'uid',
            'hand',
            'deck',
            'battleDeckSnapshot'
          ])
          && request.resource.data.hand is list
          && request.resource.data.deck is list
          && (
            !request.resource.data.keys().hasAny([
              'battleDeckSnapshot'
            ])
            ||
            isValidBattleDeckSnapshotShape(
              request.resource.data.battleDeckSnapshot
            )
          )
          && (
            (
              playerRole == 'host'
              && get(
                /databases/$(database)/documents/rooms/$(roomId)
              ).data.hostUid == request.auth.uid
            )
            ||
            (
              playerRole == 'guest'
              && get(
                /databases/$(database)/documents/rooms/$(roomId)
              ).data.guestUid == request.auth.uid
            )
          );

        allow read: if request.auth != null
          && (
            (
              playerRole == 'host'
              && get(
                /databases/$(database)/documents/rooms/$(roomId)
              ).data.hostUid == request.auth.uid
            )
            ||
            (
              playerRole == 'guest'
              && get(
                /databases/$(database)/documents/rooms/$(roomId)
              ).data.guestUid == request.auth.uid
            )
          );

        allow update: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && (
            (
              resource.data.uid == request.auth.uid
              && request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasOnly([
                  'hand',
                  'deck',
                  'battleDeckSnapshot'
                ])
              && (
                get(
                  /databases/$(database)/documents/rooms/$(roomId)
                ).data.battlePhase == 'setup'
                ||
                (
                  get(
                    /databases/$(database)/documents/rooms/$(roomId)
                  ).data.battlePhase == 'finished'
                  && get(
                    /databases/$(database)/documents/rooms/$(roomId)
                  ).data.rematchHost == true
                  && get(
                    /databases/$(database)/documents/rooms/$(roomId)
                  ).data.rematchGuest == true
                )
              )
              && (
                !request.resource.data.diff(resource.data)
                  .affectedKeys()
                  .hasAny([
                    'battleDeckSnapshot'
                  ])
                ||
                (
                  request.resource.data.keys().hasAny([
                    'battleDeckSnapshot'
                  ])
                  &&
                  isValidBattleDeckSnapshotShape(
                    request.resource.data.battleDeckSnapshot
                  )
                )
                ||
                (
                  !request.resource.data.keys().hasAny([
                    'battleDeckSnapshot'
                  ])
                )
              )
            )
            ||
            (
              resource.data.uid == request.auth.uid
              && request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasOnly([
                  'uid',
                  'hand',
                  'deck',
                  'battleDeckSnapshot'
                ])
              && (
                get(
                  /databases/$(database)/documents/rooms/$(roomId)
                ).data.battlePhase == 'setup'
                ||
                (
                  get(
                    /databases/$(database)/documents/rooms/$(roomId)
                  ).data.battlePhase == 'finished'
                  && get(
                    /databases/$(database)/documents/rooms/$(roomId)
                  ).data.rematchHost == true
                  && get(
                    /databases/$(database)/documents/rooms/$(roomId)
                  ).data.rematchGuest == true
                )
              )
              && (
                !request.resource.data.diff(resource.data)
                  .affectedKeys()
                  .hasAny([
                    'battleDeckSnapshot'
                  ])
                ||
                (
                  request.resource.data.keys().hasAny([
                    'battleDeckSnapshot'
                  ])
                  &&
                  isValidBattleDeckSnapshotShape(
                    request.resource.data.battleDeckSnapshot
                  )
                )
                ||
                (
                  !request.resource.data.keys().hasAny([
                    'battleDeckSnapshot'
                  ])
                )
              )
            )
          );

        allow delete: if
          request.auth != null
          &&
          (
            (
              get(
                /databases/$(database)/documents/rooms/$(roomId)
              ).data.roomClosed == true
              &&
              (
                get(
                  /databases/$(database)/documents/rooms/$(roomId)
                ).data.hostUid == request.auth.uid
                ||
                get(
                  /databases/$(database)/documents/rooms/$(roomId)
                ).data.guestUid == request.auth.uid
              )
            )
            ||
            isStaleClosedRoomCleanup()
          );
      }

      match /cards/{cardId} {
        allow read: if request.auth != null;
        allow create, update, delete: if false;
      }

      match /cardOwners/{cardId} {
        allow read, create, update, delete: if false;
      }

      match /characterProfileIndex/{profileHash} {
        allow read, create, update, delete: if false;
      }
    }
  }
}
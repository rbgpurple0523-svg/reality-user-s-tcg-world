rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /rooms/{roomId} {

function isStageStale() {
  let hostSeen =
    resource.data.hostLastSeenAt is number
      ? resource.data.hostLastSeenAt
      : 0;

  let guestSeen =
    resource.data.guestLastSeenAt is number
      ? resource.data.guestLastSeenAt
      : 0;

  let createdAt =
    resource.data.createdAt is number
      ? resource.data.createdAt
      : 0;

  let now =
    request.time.toMillis();

  return
    (
      (hostSeen == 0 || now - hostSeen > 60000)
      &&
      (guestSeen == 0 || now - guestSeen > 60000)
    )
    ||
    (
      hostSeen == 0
      && guestSeen == 0
      && createdAt > 0
      && now - createdAt > 60000
    );
}

function isValidBattleStateTransition() {
  return

    // ===================================================
    // ゲーム進行状態を変更していない
    // ===================================================
    (
      !request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny([
          'currentYear',
          'turnIndex',
          'battlePhase',
          'firstPlayer',
          'startSeasonIdx'
        ])
    )

    ||

    // ===================================================
    // 初回Room戦闘状態の初期化
    // ===================================================
    (
      !resource.data.keys().hasAny([
        'currentYear',
        'turnIndex',
        'battlePhase',
        'firstPlayer',
        'startSeasonIdx'
      ])

      &&
      request.resource.data.currentYear == 1
      &&
      request.resource.data.turnIndex == 0
      &&
      request.resource.data.battlePhase == 'setup'
      &&
      request.resource.data.firstPlayer == null
      &&
      request.resource.data.startSeasonIdx == null
    )

    ||

    // ===================================================
    // battle中：通常ターン
    // 例）turn 2 → turn 3
    // ===================================================
    (
      resource.data.battlePhase == 'battle'
      &&
      resource.data.turnIndex >= 0
      &&
      resource.data.turnIndex < 7

      &&
      request.resource.data.currentYear
        == resource.data.currentYear

      &&
      request.resource.data.turnIndex
        == resource.data.turnIndex + 1

      &&
      request.resource.data.battlePhase
        == 'battle'

      &&
      request.resource.data.firstPlayer
        == resource.data.firstPlayer

      &&
      request.resource.data.startSeasonIdx
        == resource.data.startSeasonIdx
    )

    ||

    // ===================================================
    // クラス終了 → 次クラス setup
    // 例）year1 turn7 → year2 turn0
    // ===================================================
    (
      resource.data.battlePhase == 'battle'
      &&
      resource.data.turnIndex == 7
      &&
      resource.data.currentYear < 3

      &&
      request.resource.data.currentYear
        == resource.data.currentYear + 1

      &&
      request.resource.data.turnIndex == 0
      &&
      request.resource.data.battlePhase == 'setup'
      &&
      request.resource.data.firstPlayer == null
      &&
      request.resource.data.startSeasonIdx == null
    )

    ||

    // ===================================================
    // 3年目最終ターン → finished
    // ===================================================
    (
      resource.data.battlePhase == 'battle'
      &&
      resource.data.currentYear == 3
      &&
      resource.data.turnIndex == 7

      &&
      request.resource.data.currentYear == 3
      &&
      request.resource.data.turnIndex == 7
      &&
      request.resource.data.battlePhase == 'finished'

      &&
      request.resource.data.firstPlayer
        == resource.data.firstPlayer

      &&
      request.resource.data.startSeasonIdx
        == resource.data.startSeasonIdx
    )

    ||

    // ===================================================
    // setup → battle
    // コイントス後
    // ===================================================
    (
      resource.data.battlePhase == 'setup'
      &&
      request.resource.data.battlePhase == 'battle'

      &&
      request.resource.data.currentYear
        == resource.data.currentYear

      &&
      request.resource.data.turnIndex == 0

      &&
      (
        request.resource.data.firstPlayer == 'host'
        ||
        request.resource.data.firstPlayer == 'guest'
      )

      &&
      request.resource.data.startSeasonIdx == 0
    )

    ||

    // ===================================================
    // setup状態の再保存
    // ===================================================
    (
      resource.data.battlePhase == 'setup'
      &&
      request.resource.data.battlePhase == 'setup'

      &&
      request.resource.data.currentYear
        == resource.data.currentYear

      &&
      request.resource.data.turnIndex == 0

      &&
      request.resource.data.firstPlayer == null

      &&
      request.resource.data.startSeasonIdx == null
    );
}

      allow read: if request.auth != null;

      // ルーム新規作成
      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid;

      // ルーム更新
allow update: if request.auth != null
  && (
    // =====================================================
    // Hostの更新
    // =====================================================
(
  resource.data.hostUid == request.auth.uid
  && request.resource.data.hostUid == resource.data.hostUid
  && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
    'hostDeckId',
    'readyHost',
    'rematchHost',
    'rematchPlayerResetHost',
    'exitHost',
    'hostJoined',
    'hostLastSeenAt',
    'hostClassScores',
    'hostTotalScore',
    'currentYear',
    'firstPlayer',
    'startSeasonIdx',
    'turnIndex',
    'battlePhase'
  ])

&& isValidBattleStateTransition()

&& (
  // =====================================================
  // HostのScoreを変更していない場合
  // =====================================================
  !request.resource.data.diff(resource.data)
    .affectedKeys()
    .hasAny([
      'hostClassScores',
      'hostTotalScore'
    ])

  ||

  // =====================================================
  // HostのScoreを変更する場合
  // 同じTransaction内でSkill Actionが処理されていること
  // =====================================================
  (
    getAfter(
      /databases/$(database)/documents/rooms/$(roomId)/players/host
    ).data.lastSkillActionId is string

    && getAfter(
      /databases/$(database)/documents/rooms/$(roomId)/players/host
    ).data.lastSkillActionId != ''

    // Score更新と一緒にlastSkillActionIdが更新されている
    && (
      !get(
        /databases/$(database)/documents/rooms/$(roomId)/players/host
      ).data.keys().hasAny([
        'lastSkillActionId'
      ])
      ||
      getAfter(
        /databases/$(database)/documents/rooms/$(roomId)/players/host
      ).data.lastSkillActionId
      !=
      get(
        /databases/$(database)/documents/rooms/$(roomId)/players/host
      ).data.lastSkillActionId
    )

    // pendingActionとAction IDが一致
    && getAfter(
      /databases/$(database)/documents/rooms/$(roomId)/players/host
    ).data.pendingAction.actionId
      ==
      getAfter(
        /databases/$(database)/documents/rooms/$(roomId)/players/host
      ).data.lastSkillActionId

    // USE_SKILLである
    && getAfter(
      /databases/$(database)/documents/rooms/$(roomId)/players/host
    ).data.pendingAction.type
      == 'USE_SKILL'
  )
)

&& (
  // =====================================================
  // Stage 4-①-B
  // ゲーム状態フィールドを変更していない場合は
  // 追加検証を行わない。
  // =====================================================

  !request.resource.data.diff(resource.data).affectedKeys().hasAny([
    'currentYear',
    'turnIndex',
    'battlePhase',
    'firstPlayer',
    'startSeasonIdx',
    'hostClassScores',
    'guestClassScores',
    'hostTotalScore',
    'guestTotalScore'
  ])

  ||

  (
    // ===================================================
    // currentYear
    // ===================================================

    (
      !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'currentYear'
      ])
      ||
      (
        request.resource.data.currentYear is int
        && request.resource.data.currentYear >= 1
        && request.resource.data.currentYear <= 3
      )
    )

    // ===================================================
    // turnIndex
    // ===================================================

    &&
    (
      !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'turnIndex'
      ])
      ||
      (
        request.resource.data.turnIndex is int
        && request.resource.data.turnIndex >= 0
        && request.resource.data.turnIndex <= 7
      )
    )

    // ===================================================
    // battlePhase
    // ===================================================

    &&
    (
      !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'battlePhase'
      ])
      ||
      (
        request.resource.data.battlePhase == 'setup'
        || request.resource.data.battlePhase == 'battle'
        || request.resource.data.battlePhase == 'finished'
      )
    )

    // ===================================================
    // firstPlayer
    // ===================================================

    &&
    (
      !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'firstPlayer'
      ])
      ||
      (
        request.resource.data.firstPlayer == null
        || request.resource.data.firstPlayer == 'host'
        || request.resource.data.firstPlayer == 'guest'
      )
    )

    // ===================================================
    // startSeasonIdx
    // ===================================================

    &&
    (
      !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'startSeasonIdx'
      ])
      ||
      (
        request.resource.data.startSeasonIdx == null
        ||
        (
          request.resource.data.startSeasonIdx is int
          && request.resource.data.startSeasonIdx >= 0
          && request.resource.data.startSeasonIdx <= 3
        )
      )
    )

    // ===================================================
    // Host class scores
    // ===================================================

    &&
    (
      !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'hostClassScores'
      ])
      ||
      (
        request.resource.data.hostClassScores is list
        && request.resource.data.hostClassScores.size() == 3
        && request.resource.data.hostClassScores[0] is number
        && request.resource.data.hostClassScores[0] >= 0
        && request.resource.data.hostClassScores[1] is number
        && request.resource.data.hostClassScores[1] >= 0
        && request.resource.data.hostClassScores[2] is number
        && request.resource.data.hostClassScores[2] >= 0
      )
    )

    // ===================================================
    // Guest class scores
    // ===================================================

    &&
    (
      !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'guestClassScores'
      ])
      ||
      (
        request.resource.data.guestClassScores is list
        && request.resource.data.guestClassScores.size() == 3
        && request.resource.data.guestClassScores[0] is number
        && request.resource.data.guestClassScores[0] >= 0
        && request.resource.data.guestClassScores[1] is number
        && request.resource.data.guestClassScores[1] >= 0
        && request.resource.data.guestClassScores[2] is number
        && request.resource.data.guestClassScores[2] >= 0
      )
    )

    // ===================================================
    // Host total
    // ===================================================

    &&
    (
      !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'hostTotalScore'
      ])
      ||
      (
        request.resource.data.hostTotalScore is number
        && request.resource.data.hostTotalScore >= 0
      )
    )

    // ===================================================
    // Guest total
    // ===================================================

    &&
    (
      !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'guestTotalScore'
      ])
      ||
      (
        request.resource.data.guestTotalScore is number
        && request.resource.data.guestTotalScore >= 0
      )
    )
  )
)
)
    ||

    // =====================================================
    // 両者が「もう一回」を選択した後の再戦リセット
    // Hostだけが実行可能
    // =====================================================
    (
      resource.data.hostUid == request.auth.uid
      && resource.data.rematchHost == true
      && resource.data.rematchGuest == true

      && request.resource.data.hostUid
        == resource.data.hostUid

      && request.resource.data.guestUid
        == resource.data.guestUid

      && request.resource.data.battlePhase
        == 'setup'

      && request.resource.data.currentYear
        == 1

      && request.resource.data.turnIndex
        == 0

      && request.resource.data.firstPlayer
        == null

      && request.resource.data.startSeasonIdx
        == null

      && request.resource.data.hostTotalScore
        == 0

      && request.resource.data.guestTotalScore
        == 0

      && request.resource.data.hostClassScores
        == [0, 0, 0]

      && request.resource.data.guestClassScores
        == [0, 0, 0]

      && request.resource.data.rematchHost
        == false

      && request.resource.data.rematchGuest
        == false

      && request.resource.data.exitHost
        == false

      && request.resource.data.exitGuest
        == false

      && request.resource.data.readyHost
        == false

      && request.resource.data.readyGuest
        == false

&& request.resource.data.diff(resource.data).affectedKeys().hasOnly
([
  'battlePhase','currentYear','turnIndex','firstPlayer','startSeasonIdx',
  'hostTotalScore','guestTotalScore','hostClassScores','guestClassScores',
  'rematchHost','rematchGuest','exitHost','exitGuest',
  'readyHost','readyGuest',
  'rematchPlayerResetHost','rematchPlayerResetGuest'
])

&& request.resource.data.rematchPlayerResetHost == false
&& request.resource.data.rematchPlayerResetGuest == false

)
    ||

    // =====================================================
    // Guestの更新
    // =====================================================
(
  resource.data.guestUid == request.auth.uid
  && request.resource.data.hostUid == resource.data.hostUid
  && request.resource.data.guestUid == resource.data.guestUid
  && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
    'guestDeckId',
    'readyGuest',
    'rematchGuest',
    'rematchPlayerResetGuest',
    'exitGuest',
    'guestJoined',
    'guestLastSeenAt',
    'guestRejoinedAt',
    'guestClassScores',
    'guestTotalScore',
    'currentYear',
    'firstPlayer',
    'startSeasonIdx',
    'turnIndex',
    'battlePhase'
  ])

&& isValidBattleStateTransition()

&& (
  !request.resource.data.diff(resource.data)
    .affectedKeys()
    .hasAny([
      'guestClassScores',
      'guestTotalScore'
    ])

  ||

  (
    getAfter(
      /databases/$(database)/documents/rooms/$(roomId)/players/guest
    ).data.lastSkillActionId is string

    && getAfter(
      /databases/$(database)/documents/rooms/$(roomId)/players/guest
    ).data.lastSkillActionId != ''

    && (
      !get(
        /databases/$(database)/documents/rooms/$(roomId)/players/guest
      ).data.keys().hasAny([
        'lastSkillActionId'
      ])
      ||
      getAfter(
        /databases/$(database)/documents/rooms/$(roomId)/players/guest
      ).data.lastSkillActionId
      !=
      get(
        /databases/$(database)/documents/rooms/$(roomId)/players/guest
      ).data.lastSkillActionId
    )

    && getAfter(
      /databases/$(database)/documents/rooms/$(roomId)/players/guest
    ).data.pendingAction.actionId
      ==
      getAfter(
        /databases/$(database)/documents/rooms/$(roomId)/players/guest
      ).data.lastSkillActionId

    && getAfter(
      /databases/$(database)/documents/rooms/$(roomId)/players/guest
    ).data.pendingAction.type
      == 'USE_SKILL'
  )
)

&& (
  !request.resource.data.diff(resource.data)
    .affectedKeys()
    .hasAny([
      'firstPlayer',
      'startSeasonIdx'
    ])
  ||
  (
    request.resource.data.firstPlayer == null
    && request.resource.data.startSeasonIdx == null
  )
  ||
  (
    request.resource.data.firstPlayer
      == resource.data.firstPlayer
    && request.resource.data.startSeasonIdx
      == resource.data.startSeasonIdx
  )
)

&& (
  // =====================================================
  // Stage 4-①-B
  // ゲーム状態フィールドを変更していない場合は
  // 追加検証を行わない。
  // =====================================================

  !request.resource.data.diff(resource.data).affectedKeys().hasAny([
    'currentYear',
    'turnIndex',
    'battlePhase',
    'firstPlayer',
    'startSeasonIdx',
    'hostClassScores',
    'guestClassScores',
    'hostTotalScore',
    'guestTotalScore'
  ])

  ||

  (
    // ===================================================
    // currentYear
    // ===================================================

    (
      !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'currentYear'
      ])
      ||
      (
        request.resource.data.currentYear is int
        && request.resource.data.currentYear >= 1
        && request.resource.data.currentYear <= 3
      )
    )

    // ===================================================
    // turnIndex
    // ===================================================

    &&
    (
      !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'turnIndex'
      ])
      ||
      (
        request.resource.data.turnIndex is int
        && request.resource.data.turnIndex >= 0
        && request.resource.data.turnIndex <= 7
      )
    )

    // ===================================================
    // battlePhase
    // ===================================================

    &&
    (
      !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'battlePhase'
      ])
      ||
      (
        request.resource.data.battlePhase == 'setup'
        || request.resource.data.battlePhase == 'battle'
        || request.resource.data.battlePhase == 'finished'
      )
    )

    // ===================================================
    // firstPlayer
    // ===================================================

    &&
    (
      !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'firstPlayer'
      ])
      ||
      (
        request.resource.data.firstPlayer == null
        || request.resource.data.firstPlayer == 'host'
        || request.resource.data.firstPlayer == 'guest'
      )
    )

    // ===================================================
    // startSeasonIdx
    // ===================================================

    &&
    (
      !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'startSeasonIdx'
      ])
      ||
      (
        request.resource.data.startSeasonIdx == null
        ||
        (
          request.resource.data.startSeasonIdx is int
          && request.resource.data.startSeasonIdx >= 0
          && request.resource.data.startSeasonIdx <= 3
        )
      )
    )

    // ===================================================
    // Host class scores
    // ===================================================

    &&
    (
      !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'hostClassScores'
      ])
      ||
      (
        request.resource.data.hostClassScores is list
        && request.resource.data.hostClassScores.size() == 3
        && request.resource.data.hostClassScores[0] is number
        && request.resource.data.hostClassScores[0] >= 0
        && request.resource.data.hostClassScores[1] is number
        && request.resource.data.hostClassScores[1] >= 0
        && request.resource.data.hostClassScores[2] is number
        && request.resource.data.hostClassScores[2] >= 0
      )
    )

    // ===================================================
    // Guest class scores
    // ===================================================

    &&
    (
      !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'guestClassScores'
      ])
      ||
      (
        request.resource.data.guestClassScores is list
        && request.resource.data.guestClassScores.size() == 3
        && request.resource.data.guestClassScores[0] is number
        && request.resource.data.guestClassScores[0] >= 0
        && request.resource.data.guestClassScores[1] is number
        && request.resource.data.guestClassScores[1] >= 0
        && request.resource.data.guestClassScores[2] is number
        && request.resource.data.guestClassScores[2] >= 0
      )
    )

    // ===================================================
    // Host total
    // ===================================================

    &&
    (
      !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'hostTotalScore'
      ])
      ||
      (
        request.resource.data.hostTotalScore is number
        && request.resource.data.hostTotalScore >= 0
      )
    )

    // ===================================================
    // Guest total
    // ===================================================

    &&
    (
      !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'guestTotalScore'
      ])
      ||
      (
        request.resource.data.guestTotalScore is number
        && request.resource.data.guestTotalScore >= 0
      )
    )
  )
)
)

    ||

    // =====================================================
    // Guestの初回入室
    // =====================================================
    (
      resource.data.guestUid == null
      && request.resource.data.guestUid == request.auth.uid
      && request.resource.data.hostUid == resource.data.hostUid
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'guestUid',
        'guestJoined',
        'guestRejoinedAt',
        'guestLastSeenAt'
      ])
    )
  );

     allow delete: if request.auth != null
  && isStageStale();

      match /players/{playerRole} {
        allow read: if request.auth != null;

        // プレイヤー作成
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && (
            playerRole == 'host'
            || playerRole == 'guest'
          );


function isRematchPlayerReset() {
  let room =
    get(/databases/$(database)/documents/rooms/$(roomId)).data;

  return
    room.rematchHost == true
    && room.rematchGuest == true
    && request.resource.data.handCount == 4
    && request.resource.data.deckCount == 14
    && request.resource.data.usedSkills is map
    && request.resource.data.usedSkills.keys().size() == 0
    && request.resource.data.avatars is list
    && request.resource.data.avatars.size() == 3
    && request.resource.data.lastProcessedIncomingActionId == ''
    && !request.resource.data.keys().hasAny([
      'pendingAction',
      'lastSkillActionId',
      'lastSkillAction',
      'lastSupportActionId',
      'lastSupportCardId',
      'lastSupportCardCountBefore',
      'lastSupportCardCountAfter',
      'lastSupportActionAt'
    ])
    && !request.resource.data.keys().hasAny([
      'hand',
      'deck'
    ])
    && request.resource.data.diff(resource.data)
      .affectedKeys()
      .hasAny([
        'pendingAction',
        'lastSkillActionId',
        'lastSkillAction',
        'lastSupportActionId',
        'lastSupportCardId',
        'lastSupportCardCountBefore',
        'lastSupportCardCountAfter',
        'lastSupportActionAt'
      ]);
}


        // 自分のプレイヤー情報だけ更新可能
allow update: if request.auth != null
  && resource.data.uid == request.auth.uid
  && request.resource.data.uid == resource.data.uid
  && request.resource.data.role == resource.data.role
  && request.resource.data.createdAt == resource.data.createdAt

  // -----------------------------------------------------
  // Player自身が変更できるフィールドを固定
  // -----------------------------------------------------
  && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
    'joined',
    'ready',
    'lastSeenAt',
    'avatars',
    'handCount',
    'deckCount',
    'usedSkills',
    'pendingAction',
    'lastProcessedIncomingActionId',
    'lastSkillActionId',
    'lastSkillAction',
    'lastSupportActionId',
    'lastSupportCardId',
    'lastSupportCardCountBefore',
    'lastSupportCardCountAfter',
    'lastSupportActionAt',
    'hand',
    'deck'
  ])

  // lastSkillAction は通常プレイ中のクライアント変更を禁止
  // 再戦初期化時の削除だけ許可
  && (
    !request.resource.data.diff(resource.data)
      .affectedKeys()
      .hasAny(['lastSkillAction'])
    ||
    isRematchPlayerReset()
  )

  // hand / deck本体は公開Playerへ保存させない
  && !request.resource.data.keys().hasAny([
    'hand',
    'deck'
  ])

  // =====================================================
  // Stage 4-①-A
  // pendingAction を変更する場合の厳格チェック
  // =====================================================
&& (
  isRematchPlayerReset()
  ||
  !request.resource.data.diff(resource.data)
    .affectedKeys()
    .hasAny(['pendingAction'])
  ||
  (
    request.resource.data.pendingAction is map
    && request.resource.data.pendingAction.keys().hasAll([
      'actionId','type','playerRole','uid','year','turnIndex',
      'avatarIndex','submittedAt'
    ])
    && request.resource.data.pendingAction.keys().hasOnly([
      'actionId','type','playerRole','uid','year','turnIndex',
      'avatarIndex','skillId','selectedBoostStat','supportCardId',
      'submittedAt','supportCardConsumed','supportCardCountBefore',
      'supportCardCountAfter'
    ])
    && request.resource.data.pendingAction.actionId is string
    && request.resource.data.pendingAction.actionId != ''
    && (
      request.resource.data.pendingAction.type == 'USE_SKILL'
      ||
      request.resource.data.pendingAction.type == 'PLAY_SUPPORT'
    )
    && request.resource.data.pendingAction.playerRole == playerRole
    && request.resource.data.pendingAction.uid == request.auth.uid
    && request.resource.data.pendingAction.year
      == get(/databases/$(database)/documents/rooms/$(roomId)).data.currentYear
    && request.resource.data.pendingAction.turnIndex
      == get(/databases/$(database)/documents/rooms/$(roomId)).data.turnIndex
    && get(/databases/$(database)/documents/rooms/$(roomId)).data.battlePhase == 'battle'
    && request.resource.data.pendingAction.avatarIndex
      == (get(/databases/$(database)/documents/rooms/$(roomId)).data.currentYear - 1)
    && request.resource.data.pendingAction.avatarIndex >= 0
    && request.resource.data.pendingAction.avatarIndex <= 2
    && request.resource.data.pendingAction.playerRole
      == (
        get(/databases/$(database)/documents/rooms/$(roomId)).data.turnIndex % 2 == 0
        ?
          get(/databases/$(database)/documents/rooms/$(roomId)).data.firstPlayer
        :
          (
            get(/databases/$(database)/documents/rooms/$(roomId)).data.firstPlayer == 'host'
            ? 'guest'
            : 'host'
          )
      )
    && (
      (
        request.resource.data.pendingAction.type == 'USE_SKILL'
        && request.resource.data.pendingAction.keys().hasAll(['skillId'])
        && request.resource.data.pendingAction.skillId is string
        && request.resource.data.pendingAction.skillId != ''
        && !request.resource.data.pendingAction.keys().hasAny([
          'supportCardId',
          'supportCardConsumed',
          'supportCardCountBefore',
          'supportCardCountAfter'
        ])
        && (
          !request.resource.data.pendingAction.keys().hasAny(['selectedBoostStat'])
          ||
          request.resource.data.pendingAction.selectedBoostStat == 'hp'
          ||
          request.resource.data.pendingAction.selectedBoostStat == 'intellect'
          ||
          request.resource.data.pendingAction.selectedBoostStat == 'dexterity' ||
          request.resource.data.pendingAction.selectedBoostStat == 'charm'
        )
      )
      ||
      (
        request.resource.data.pendingAction.type == 'PLAY_SUPPORT'
        && request.resource.data.pendingAction.keys().hasAll([
          'supportCardId',
          'supportCardConsumed',
          'supportCardCountBefore',
          'supportCardCountAfter'
        ])
        && request.resource.data.pendingAction.supportCardId is string
        && request.resource.data.pendingAction.supportCardId != ''
        && request.resource.data.pendingAction.supportCardConsumed == true
        && request.resource.data.pendingAction.supportCardCountBefore >= 1
        && request.resource.data.pendingAction.supportCardCountAfter
          == request.resource.data.pendingAction.supportCardCountBefore - 1
        && !request.resource.data.pendingAction.keys().hasAny([
          'skillId',
          'selectedBoostStat'
        ])
      )
    )
  )
)


// =====================================================
// Skill Action処理済みID
// =====================================================

&& (
  isRematchPlayerReset()
  ||
  !request.resource.data.diff(resource.data)
    .affectedKeys()
    .hasAny(['lastSkillActionId'])
  ||
  (
    request.resource.data.lastSkillActionId is string
    && request.resource.data.lastSkillActionId != ''
    && request.resource.data.pendingAction is map
    && request.resource.data.pendingAction.actionId
      == request.resource.data.lastSkillActionId
    && request.resource.data.pendingAction.type == 'USE_SKILL'
  )
)


// =====================================================
// Support Action処理済みID
// =====================================================

&& (
  isRematchPlayerReset()
  ||
  !request.resource.data.diff(resource.data)
    .affectedKeys()
    .hasAny(['lastSupportActionId'])
  ||
  (
    request.resource.data.lastSupportActionId is string
    && request.resource.data.lastSupportActionId != ''
    && request.resource.data.pendingAction is map
    && request.resource.data.pendingAction.actionId
      == request.resource.data.lastSupportActionId
    && request.resource.data.pendingAction.type == 'PLAY_SUPPORT'
    && request.resource.data.pendingAction.supportCardConsumed == true
  )
);
        allow delete: if false;
      }

match /privatePlayers/{playerRole} {

  // -----------------------------------------
  // 作成
  // 自分自身のprivatePlayerだけ作成可能
  // -----------------------------------------
  allow create: if request.auth != null
    && request.resource.data.uid == request.auth.uid
    && (
      (
        playerRole == 'host'
        && get(
          /databases/$(database)/documents/rooms/$(roomId)
        ).data.hostUid == request.auth.uid
      )
      ||
      (
        playerRole == 'guest'
        && get(
          /databases/$(database)/documents/rooms/$(roomId)
        ).data.guestUid == request.auth.uid
      )
    );

  // -----------------------------------------
  // 読み取り
  // 自分自身のprivatePlayerだけ読める
  // -----------------------------------------
  allow read: if request.auth != null
    && (
      (
        playerRole == 'host'
        && get(
          /databases/$(database)/documents/rooms/$(roomId)
        ).data.hostUid == request.auth.uid
      )
      ||
      (
        playerRole == 'guest'
        && get(
          /databases/$(database)/documents/rooms/$(roomId)
        ).data.guestUid == request.auth.uid
      )
    );

  // -----------------------------------------
  // 更新
  // hand / deckだけ変更可能
  // uidは変更禁止
  // -----------------------------------------
  allow update: if request.auth != null
    && resource.data.uid == request.auth.uid
    && request.resource.data.uid == resource.data.uid
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
      'hand',
      'deck'
    ]);

  // 削除は禁止
  allow delete: if false;
}
    }
  }
}